# ============================================================================
# TERMBridge Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in your Supabase project values.
#
# Without these variables, TERMBridge runs in demo mode with mock data.
# ============================================================================

# --- Supabase Project (required for database mode) ---
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase Service Role Key (server-side only, for seed script) ---
# NEVER prefix with NEXT_PUBLIC_. Used only by scripts/seed.ts.
# Found in: Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo Account Credentials (used by seed script to create demo user) ---
# These are only consumed by `npm run db:seed`. Never hardcode in source.
TERMBRIDGE_DEMO_EMAIL=
TERMBRIDGE_DEMO_PASSWORD=

# --- PayPal Sandbox Invoicing & Payments (Module 5) ---
# Server-side only. NEVER prefix with NEXT_PUBLIC_.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Strict safety latch: Live mode is permanently disabled for this hackathon build.
PAYPAL_ENABLE_LIVE_MODE=false

